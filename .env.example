# =====================================================================
# Environment matrix (ADR-3D.3 Output 8). Copy to .env.local for dev.
# NEVER commit real secrets. Dev/pilot only on Vercel Hobby + Supabase Free.
# =====================================================================

# --- Application data-layer connections (role-scoped) ----------------
# Public surface connects as the least-privilege role app_public (views only).
APP_PUBLIC_DB_URL=postgres://app_public@127.0.0.1:5433/setda_app
# Admin surface connects as app_admin (base tables) behind Auth + RBAC.
APP_ADMIN_DB_URL=postgres://app_admin@127.0.0.1:5433/setda_app

# --- Migrations (direct connection, session mode; NOT the pooler) -----
DATABASE_URL_DIRECT=postgres://postgres@127.0.0.1:5433/setda_app

# --- Supabase Auth (provider = MVP default; leave blank in local dev) --
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=            # server-only, used to verify Auth JWTs

# NOTE for Supabase (serverless runtime): use the Supavisor POOLER url
# (transaction mode) for APP_*_DB_URL, and the DIRECT url only for migrations.
